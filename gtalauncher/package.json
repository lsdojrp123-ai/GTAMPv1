{
  "name": "gtamp-launcher",
  "version": "2.2.2",
  "description": "GTAMP - GTA Multiplayer Launcher (FiveM-style) \u2014 splash startup, ownership check, connect loading",
  "main": "src/main/main.js",
  "author": "GTAMP",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64",
    "server": "node src/fxserver/index.js"
  },
  "build": {
    "appId": "com.gtamp.launcher",
    "productName": "GTAMP Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/renderer/**/*",
      "src/fxserver/**/*",
      "src/client/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-bin",
        "to": "native",
        "filter": [
          "*.exe",
          "*.dll"
        ]
      },
      {
        "from": "src/client/client-bridge.js",
        "to": "client/client-bridge.js"
      },
      {
        "from": "node_modules/ws",
        "to": "client/node_modules/ws"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "sign": null,
      "signingHashAlgorithms": [],
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "GTAMP-Launcher-v${version}.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "GTAMP-v160-0ea2edd"
    },
    "asarUnpack": [
      "**/client/client-bridge.js",
      "**/node_modules/ws/**/*"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GTAMP",
      "runAfterFinish": true,
      "artifactName": "GTAMP-Setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "ws": "^8.21.1",
    "discord-rpc": "^4.0.1"
  }
}
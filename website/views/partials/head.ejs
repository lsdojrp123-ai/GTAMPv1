<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' && title ? title + ' - ' : '' %>GTAMP</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500&family=Rubik:ital,wght@0,300;0,400;1,300;1,400&family=Material+Icons+Outlined&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header>
  <div class="bar">
    <a href="/" class="logo"><span class="logo-img">G</span><span class="logo-title">GTAMP</span></a>
    <ul class="links">
      <li><a href="/servers" class="<%= page==='/servers'?'active':'' %>">Server List</a></li>
      <li><a href="/support" class="<%= page==='/support'?'active':'' %>">Support</a></li>
      <li><a href="/keymaster" class="<%= page==='/keymaster'?'active':'' %>">Portal</a></li>
      <li><a href="/forum" class="<%= page==='/forum'?'active':'' %>">Forum</a></li>
      <li><a href="/marketplace" class="<%= page==='/marketplace'?'active':'' %>">Marketplace</a></li>
      <li><a href="/docs" class="<%= page==='/docs'?'active':'' %>">Documentation</a></li>
      <% if (user) { %>
        <li><a href="/logout">Logout (<%= user.username %>)</a></li>
      <% } else { %>
        <li><a href="/login">Login</a></li>
      <% } %>
    </ul>
  </div>
</header>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %>GTAMP</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header>
  <div class="wrap nav">
    <a href="/" class="brand"><span class="mark">G</span>GTAMP</a>
    <a href="/" class="navlink <%= page==='/'?'active':'' %>">Home</a>
    <a href="/servers" class="navlink <%= page==='/servers'?'active':'' %>">Server List</a>
    <a href="/forum" class="navlink">Forum</a>
    <a href="/marketplace" class="navlink">Marketplace</a>
    <a href="/docs" class="navlink">Documentation</a>
    <a href="/support" class="navlink">Support</a>
    <div class="spacer"></div>
    <% if (user) { %>
      <a href="/keymaster" class="btn btn-ghost btn-sm">Keymaster</a>
      <span class="nav-user muted"><%= user.username %></span>
      <a href="/logout" class="btn btn-ghost btn-sm">Logout</a>
    <% } else { %>
      <a href="/login" class="btn btn-ghost btn-sm">Login</a>
      <a href="/register" class="btn btn-accent btn-sm">Register</a>
    <% } %>
  </div>
</header>
